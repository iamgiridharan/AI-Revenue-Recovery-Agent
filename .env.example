[TEMPLATE]
# Revenue Recovery Agent - Environment Configuration
# Copy this file to .env and fill in your values

# Database
# For local PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/revenue_recovery
# For Render/Railway: paste the full connection string from the provider
DATABASE_URL=postgresql+psycopg2://<username>:<password>@<host>:<port>/<database>

# Razorpay (Test Mode ONLY — never Live Mode)
# Dashboard -> Account & Settings -> API Keys -> Generate Test Key (rzp_test_...).
# The secret is shown once, next to the key id.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Account & Settings -> Webhooks -> Add New Webhook.
# URL: https://<public-host>/api/webhooks/razorpay  (use an HTTPS tunnel while
# developing, e.g. `ngrok http 8000`); secret: a value you choose, entered here.
# Webhooks are rejected with 401 while this is empty (the handler fails closed).
RAZORPAY_WEBHOOK_SECRET=

# LLM API
LLM_API_KEY=

# Backend
DEBUG=true
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
