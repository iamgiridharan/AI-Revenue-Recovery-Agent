# Revenue Recovery Agent - Environment Configuration
# Copy this file to .env and fill in your values

# Database
# For local PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/revenue_recovery
# For Render/Railway: paste the full connection string from the provider
DATABASE_URL=postgresql+psycopg2://<username>:<password>@<host>:<port>/<database>

# Razorpay (Test Mode ONLY — never Live Mode)
# Dashboard -> Account & Settings -> API Keys -> Generate Test Key (rzp_test_...).
# The secret is shown once, next to the key id.
# A live key (rzp_live_...) is REFUSED at startup: it is discarded, no payment
# client is created, and /api/config/status reports LIVE_REJECTED.
# Set BOTH values or NEITHER: a key without its secret (or an unrecognised key
# prefix) is reported as UNCONFIGURED and payment execution is refused -- it does
# not fall back to mock links. Neither value set means MOCK mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Account & Settings -> Webhooks -> Add New Webhook.
# URL: https://<public-host>/api/webhooks/razorpay  (use an HTTPS tunnel while
# developing, e.g. `ngrok http 8000`); secret: a value you choose, entered here.
# Webhooks are rejected with 401 while this is empty (the handler fails closed).
RAZORPAY_WEBHOOK_SECRET=

# LLM API
LLM_API_KEY=

# Frontend-only (frontend/.env.local): the same value as DEMO_API_KEY.
# VITE_* values are compiled into the browser bundle and are NOT secret --
# this is a local academic-demo convenience, not a security boundary.
# VITE_DEMO_API_KEY=

# Backend
DEBUG=true
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Demonstration authentication (single shared secret, single actor).
# Mutating routes (diagnose, recovery, review, policy, simulation) require it:
#   X-API-Key: <value>     (or: Authorization: Bearer <value>)
# Unset here -> protected routes answer 503; wrong/missing at call time -> 401.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DEMO_API_KEY=
